// CBES portal, admin and Steward crew app. Routes /portal*, /admin* and /steward* on the same hostnames as
// the public site (cbes-web serves everything else, cbes-api serves /api/*). Routes, not custom domains, so
// the most specific pattern wins.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbes-admin-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Only reachable on the cbenvironments.com routes below, never on *.workers.dev.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "cbes-admin-staging",
      "routes": [
        { "pattern": "staging.cbenvironments.com/portal*", "zone_name": "cbenvironments.com" },
        { "pattern": "staging.cbenvironments.com/admin*", "zone_name": "cbenvironments.com" },
        { "pattern": "staging.cbenvironments.com/steward*", "zone_name": "cbenvironments.com" }
      ]
    },
    "production": {
      "name": "cbes-admin",
      "routes": [
        { "pattern": "cbenvironments.com/portal*", "zone_name": "cbenvironments.com" },
        { "pattern": "cbenvironments.com/admin*", "zone_name": "cbenvironments.com" },
        { "pattern": "cbenvironments.com/steward*", "zone_name": "cbenvironments.com" }
      ]
    }
  }
}
